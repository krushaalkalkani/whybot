# Copy to .env and fill in. Never commit .env.

# Claude API key from https://platform.claude.com -> API keys. Needed for live questions and evals.
ANTHROPIC_API_KEY=

# Postgres with pgvector. Local docker compose default shown. On Neon use the pooled connection string.
DATABASE_URL=postgresql://whybot:whybot@localhost:54329/whybot
# A SELECT-only login used by the SQL tool. bench/load.py creates this role from the URL.
DATABASE_URL_READONLY=postgresql://whybot_readonly:whybot_readonly@localhost:54329/whybot

# Models. Check https://platform.claude.com/docs/en/about-claude/models before changing.
WHYBOT_AGENT_MODEL=claude-haiku-5-5
WHYBOT_JUDGE_MODEL=claude-sonnet-5-5
WHYBOT_AGENT_EFFORT=medium

# Public demo protection.
WHYBOT_DAILY_SPEND_CAP_USD=1.0
WHYBOT_DAILY_QUESTIONS_PER_IP=5
WHYBOT_IP_HASH_SALT=change-me
WHYBOT_CORS_ORIGINS=*
